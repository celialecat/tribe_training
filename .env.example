# ==============================================================================
# YouTube Success Predictor — environment configuration template.
# Copy to `.env` and adjust. Values here are read by app.core.config.Settings.
# NEVER commit a populated .env (see .gitignore).
# ==============================================================================

# ---- Application ----
YSP_ENV=development                     # development | production | test
YSP_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
YSP_API_HOST=0.0.0.0
YSP_API_PORT=8000
YSP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
# SQLite by default; swap for postgresql+psycopg://user:pass@host/db in prod.
YSP_DATABASE_URL=sqlite:///./data/ysp.db

# ---- Storage paths (relative to repo root unless absolute) ----
YSP_DATA_DIR=./data
YSP_RAW_DIR=./data/raw
YSP_PROCESSED_DIR=./data/processed
YSP_CACHE_DIR=./data/cache
YSP_MODELS_DIR=./models

# ---- TRIBE v2 ----
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_CACHE_DIR=./data/cache/tribe
TRIBE_DEVICE=cuda                       # cuda | cpu
# HuggingFace token if the weights repo is gated for your account.
# HUGGING_FACE_HUB_TOKEN=hf_xxx

# ---- Compute ----
YSP_DEVICE=cuda                         # cuda | cpu
YSP_NUM_WORKERS=4

# ---- Frontend (Vite) — consumed by the React app at build time ----
VITE_API_BASE_URL=http://localhost:8000
