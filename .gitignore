# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Testing / coverage ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- ML artifacts ----
outputs/            # Hydra run directories
multirun/           # Hydra multirun directories
runs/               # TensorBoard event files
lightning_logs/
wandb/
*.ckpt
*.pt
*.pth
*.onnx
*.torchscript

# ---- Project data & model weights (never commit large binaries) ----
data/raw/*
data/processed/*
data/cache/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!models/.gitkeep

# TRIBE weight cache
.tribe_cache/

# ---- Databases ----
*.db
*.sqlite
*.sqlite3

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
